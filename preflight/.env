# Central version/config pins for the whole harness.
# Change these in ONE place; docker-compose.yml and scripts all read from here.

# --- Iceberg / lineage requirement ---
# Row lineage (_row_id via manifest inheritance) needs Iceberg >= 1.10.0 to
# avoid _row_id being silently reassigned on compaction. We pin to 1.11.0 to
# have margin. scripts/check_iceberg_version.sh enforces this at runtime.
ICEBERG_VERSION=1.11.0
ICEBERG_MIN_VERSION=1.10.0
HADOOP_VERSION=3.4.3

# --- Spark (used only for DDL + Check C fallback, never for reading _row_id) ---
SPARK_VERSION=3.5.4
SPARK_SCALA_VERSION=2.12

# --- Kafka (KRaft, single broker) ---
KAFKA_IMAGE=apache/kafka:3.7.0
KAFKA_TARBALL_VERSION=3.7.0
KAFKA_TARBALL_SCALA=2.13
KAFKA_TOPIC=events
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- MinIO (S3-compatible storage) ---
# NOTE: minio/minio and minio/mc were removed from Docker Hub entirely
# (the minio org's server/client images now live on quay.io instead).
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
MC_IMAGE=quay.io/minio/mc:RELEASE.2025-04-16T18-13-26Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=warehouse
MINIO_ENDPOINT=minio:9000
MINIO_ENDPOINT_HOST=http://localhost:9000

# --- Iceberg REST catalog ---
# NOTE: built locally from docker/iceberg-rest (org.apache.iceberg.rest.
# RESTCatalogServer compiled against ICEBERG_VERSION above), not pulled as
# tabulario/iceberg-rest -- that image's last tag (1.6.0) predates
# format-version 3 and rejects V3 CREATE TABLE requests server-side. See
# docker/iceberg-rest/pom.xml for the full story.
ICEBERG_REST_URI=http://iceberg-rest:8181
ICEBERG_REST_URI_HOST=http://localhost:8181
ICEBERG_WAREHOUSE=s3://warehouse/
ICEBERG_NAMESPACE=bronze
ICEBERG_TABLE=events

# --- AWS region placeholder (required by S3 clients even for MinIO) ---
AWS_REGION=us-east-1
