{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chrome/**",
              "components/content/**",
              "components/data/**",
              "slides/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto|Roboto Mono))/i]",
        "message": "Font not provided by the design system. Available: Roboto, Roboto Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:accent|heading|children|footer|icon|topOnly|width|height|style|key|ref|className|style|children)$/]",
        "message": "<AccentCard> doesn't accept that prop. Declared props: accent, heading, children, footer, icon, topOnly, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentCard'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:purple|blue|pink|green|cyan|orange)$/]",
        "message": "<AccentCard> accent must be one of 'purple' | 'blue' | 'pink' | 'green' | 'cyan' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgendaList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|columns|style|key|ref|className|style|children)$/]",
        "message": "<AgendaList> doesn't accept that prop. Declared props: items, columns, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChartCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|src|alt|children|width|height|style|key|ref|className|style|children)$/]",
        "message": "<ChartCard> doesn't accept that prop. Declared props: title, src, alt, children, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:headers|rows|accent|totalRow|width|style|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: headers, rows, accent, totalRow, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:purple|blue|pink|green|cyan|orange)$/]",
        "message": "<DataTable> accent must be one of 'purple' | 'blue' | 'pink' | 'green' | 'cyan' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradientPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:accent|children|align|padding|style|key|ref|className|style|children)$/]",
        "message": "<GradientPanel> doesn't accept that prop. Declared props: accent, children, align, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradientPanel'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:purple|blue|pink|green|cyan|orange)$/]",
        "message": "<GradientPanel> accent must be one of 'purple' | 'blue' | 'pink' | 'green' | 'cyan' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradientPanel'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:top|center|bottom)$/]",
        "message": "<GradientPanel> align must be one of 'top' | 'center' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HexIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:accent|size|children|outline|style|key|ref|className|style|children)$/]",
        "message": "<HexIcon> doesn't accept that prop. Declared props: accent, size, children, outline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HexIcon'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:purple|blue|pink|green|cyan|orange)$/]",
        "message": "<HexIcon> accent must be one of 'purple' | 'blue' | 'pink' | 'green' | 'cyan' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:workflow|containers|network|cost|cloud|dashboard|grid|feedback|chart-bars|pipeline|collaboration|bits|chat|people)$/]",
        "message": "<Icon> name must be one of 'workflow' | 'containers' | 'network' | 'cost' | 'cloud' | 'dashboard' | 'grid' | 'feedback' | 'chart-bars' | 'pipeline' | 'collaboration' | 'bits' | 'chat' | 'people'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LegendDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|label|size|style|key|ref|className|style|children)$/]",
        "message": "<LegendDot> doesn't accept that prop. Declared props: color, label, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|color|height|assetPath|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, color, height, assetPath, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:horizontal|stacked)$/]",
        "message": "<Logo> variant must be one of 'horizontal' | 'stacked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:purple|white)$/]",
        "message": "<Logo> color must be one of 'purple' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|headerColor|price|unit|footnote|tiers|width|style|key|ref|className|style|children)$/]",
        "message": "<PricingCard> doesn't accept that prop. Declared props: heading, headerColor, price, unit, footnote, tiers, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|background|gradient|assetPath|scale|title|subtitle|eyebrow|titleSize|align|pageNumber|logo|style|key|ref|className|style|children)$/]",
        "message": "<SlideFrame> doesn't accept that prop. Declared props: children, background, gradient, assetPath, scale, title, subtitle, eyebrow, titleSize, align, pageNumber, logo, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute[name.name='background'] > Literal[value!=/^(?:none|cover-purple|divider-purple|divider-blue-purple|divider-magenta|divider-teal|divider-orange|divider-cyan|subdivider-purple|subdivider-blue|subdivider-pink|subdivider-green|subdivider-orange|subdivider-cyan|neutral-gray)$/]",
        "message": "<SlideFrame> background must be one of 'none' | 'cover-purple' | 'divider-purple' | 'divider-blue-purple' | 'divider-magenta' | 'divider-teal' | 'divider-orange' | 'divider-cyan' | 'subdivider-purple' | 'subdivider-blue' | 'subdivider-pink' | 'subdivider-green' | 'subdivider-orange' | 'subdivider-cyan' | 'neutral-gray'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute[name.name='gradient'] > Literal[value!=/^(?:purple|blue|pink|green|cyan|orange)$/]",
        "message": "<SlideFrame> gradient must be one of 'purple' | 'blue' | 'pink' | 'green' | 'cyan' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:top|center|bottom)$/]",
        "message": "<SlideFrame> align must be one of 'top' | 'center' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute[name.name='logo'] > Literal[value!=/^(?:auto|white|purple|none)$/]",
        "message": "<SlideFrame> logo must be one of 'auto' | 'white' | 'purple' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|children|rules|width|align|style|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: value, children, rules, width, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<StatBlock> align must be one of 'left' | 'center'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
