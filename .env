# Root .env for the staged conference demo. Docker Compose `include:`
# resolves variable substitution for an included file (preflight/docker-compose.yml)
# against THIS top-level .env, not preflight/.env -- so every variable that
# file references must be mirrored here. Do not edit preflight/.env; this is
# a parallel copy plus new demo-only variables appended at the bottom.

# --- Iceberg / lineage requirement ---
ICEBERG_VERSION=1.11.0
ICEBERG_MIN_VERSION=1.10.0
HADOOP_VERSION=3.4.3

# --- Spark (DDL, MERGE, and Composable Lineage MetricsReporter) ---
SPARK_VERSION=3.5.4
SPARK_SCALA_VERSION=2.12

# --- Kafka (KRaft, single broker) ---
KAFKA_IMAGE=apache/kafka:3.7.0
KAFKA_TARBALL_VERSION=3.7.0
KAFKA_TARBALL_SCALA=2.13
KAFKA_TOPIC=events
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- MinIO (S3-compatible storage) ---
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
MC_IMAGE=quay.io/minio/mc:RELEASE.2025-04-16T18-13-26Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=warehouse
MINIO_ENDPOINT=minio:9000
MINIO_ENDPOINT_HOST=http://localhost:9000

# --- Iceberg REST catalog (preflight's reference server; the demo's clients
# use CATALOG_* below -- don't repoint these, iceberg-rest reads them too) ---
ICEBERG_REST_URI=http://iceberg-rest:8181
ICEBERG_REST_URI_HOST=http://localhost:8181
ICEBERG_WAREHOUSE=s3://warehouse/
ICEBERG_NAMESPACE=bronze
ICEBERG_TABLE=events

# --- AWS region placeholder (required by S3 clients even for MinIO) ---
AWS_REGION=us-east-1

# =====================================================================
# Demo-only additions (not present in preflight/.env)
# =====================================================================

# silver.customers: merge-on-read mutation target for Stage 02+
SILVER_NAMESPACE=silver
SILVER_TABLE=customers

# Composable Lineage: custom MetricsReporter -> lightweight collector.
# NEVER call this "BYOL" in code/docs -- always "Composable Lineage".
OPENLINEAGE_COLLECTOR_PORT=5000
OPENLINEAGE_COLLECTOR_PORT_HOST=5050
OPENLINEAGE_URL=http://openlineage-collector:5000/api/v1/lineage
OPENLINEAGE_NAMESPACE=row-level-lineage-demo

# Marquez lineage graph UI: http://localhost:${MARQUEZ_WEB_PORT_HOST}
MARQUEZ_VERSION=0.51.1
MARQUEZ_WEB_PORT_HOST=3000

# Lakekeeper catalog: UI http://localhost:${LAKEKEEPER_PORT_HOST}/ui
LAKEKEEPER_VERSION=v0.13.6
LAKEKEEPER_PORT_HOST=8282
LAKEKEEPER_WAREHOUSE=demo

# Apache Polaris catalog (alternative to Lakekeeper; profile "polaris")
POLARIS_VERSION=1.8.0
POLARIS_PORT_HOST=8383
POLARIS_CATALOG=demo
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=rll-demo-polaris-k7Q2v9
POLARIS_CONSOLE_PORT_HOST=8484

# --- The catalog every demo client uses (Spark, Kafka Connect, DuckDB,
# dashboard). Exactly one block below is active; switch with
#   scripts/use-catalog.sh polaris|lakekeeper|rest
# then `demo/run-stage.sh reset` and re-run the stages. All three passed the
# V3 round trip against the reference catalog (scripts/lakekeeper/v3_roundtrip.sh).
# CATALOG_UI_* tell the recorder which catalog UI to show.
# OPENLINEAGE_DATASET_NAMESPACE: the Marquez namespace for Iceberg tables,
# shared by every writer's reporter so they land on the same graph nodes.
# >>> catalog: lakekeeper
# CATALOG_SERVICES="lakekeeper lakekeeper-bootstrap"
# CATALOG_URI=http://lakekeeper:8181/catalog
# CATALOG_URI_HOST=http://localhost:${LAKEKEEPER_PORT_HOST}/catalog
# CATALOG_WAREHOUSE=${LAKEKEEPER_WAREHOUSE}
# CATALOG_CREDENTIAL=
# CATALOG_SCOPE=
# CATALOG_UI=lakekeeper
# OPENLINEAGE_DATASET_NAMESPACE=iceberg://lakekeeper/${LAKEKEEPER_WAREHOUSE}
# <<< catalog: lakekeeper
# >>> catalog: polaris
CATALOG_SERVICES="polaris polaris-bootstrap polaris-console"
CATALOG_URI=http://polaris:8181/api/catalog
CATALOG_URI_HOST=http://localhost:${POLARIS_PORT_HOST}/api/catalog
CATALOG_WAREHOUSE=${POLARIS_CATALOG}
CATALOG_CREDENTIAL=${POLARIS_CLIENT_ID}:${POLARIS_CLIENT_SECRET}
CATALOG_SCOPE=PRINCIPAL_ROLE:ALL
CATALOG_UI=polaris
OPENLINEAGE_DATASET_NAMESPACE=iceberg://polaris/${POLARIS_CATALOG}
# <<< catalog: polaris
# >>> catalog: rest
# CATALOG_SERVICES=iceberg-rest
# CATALOG_URI=${ICEBERG_REST_URI}
# CATALOG_URI_HOST=${ICEBERG_REST_URI_HOST}
# CATALOG_WAREHOUSE=${ICEBERG_WAREHOUSE}
# CATALOG_CREDENTIAL=
# CATALOG_SCOPE=
# CATALOG_UI=none
# OPENLINEAGE_DATASET_NAMESPACE=iceberg://rest/warehouse
# <<< catalog: rest

# Stage 05 failure-mode: separate V2 table proving equality-delete upsert
# churns _row_id. Deliberately V2 -- this is the negative-case table.
FAILURE_NAMESPACE=failure_demo
FAILURE_TABLE=customers_v2_upsert

# Which catalog/storage the read scripts (scripts/lineage_backend.py) and the
# dashboard talk to: local = MinIO + this repo's REST catalog, aws = real S3 +
# Glue Data Catalog (credentials from the AWS credential chain, never here).
LINEAGE_BACKEND=local

# Offline mode (scripts/lib.sh): auto probes Docker Hub once per run; 1 forces
# offline (skip image builds, use the images already built), 0 forces online.
# Prepare before travelling with scripts/offline-prep.sh; check with --check.
LINEAGE_OFFLINE=auto

# Live demo dashboard (dashboard/): http://localhost:${DASHBOARD_PORT_HOST}
DASHBOARD_PORT_HOST=8088

# AWS backend (LINEAGE_BACKEND=aws). Separate from AWS_REGION above, which is
# MinIO's placeholder region. Glue database = LINEAGE_NAMESPACE_PREFIX +
# namespace (rll_bronze, rll_silver, rll_failure_demo). Credentials are
# never set here: export them into your shell for the session with
#   eval "$(aws configure export-credentials --profile your-profile --format env)"
LINEAGE_AWS_REGION=us-west-1
# Set to an S3 bucket you own, e.g. row-level-lineage-demo-<account-id>-usw1.
LINEAGE_S3_BUCKET=
LINEAGE_NAMESPACE_PREFIX=rll_
